* {
  margin: 0;
  padding: 0;
  box-sizing: border-box;
  font-family: "Poppins", sans-serif;
}

body {
  background: #0d1117;
  color: #fff;
  line-height: 1.6;
}

header {
  text-align: center;
  padding: 2rem;
  background: #161b22;
}

header h1 {
  font-size: 2.5rem;
  margin-bottom: 0.5rem;
  color: #58a6ff;
}

header nav a {
  margin: 0 10px;
  text-decoration: none;
  color: #c9d1d9;
}

section {
  padding: 2rem;
}

h2 {
  color: #58a6ff;
  margin-bottom: 1rem;
}

.project {
  background: #161b22;
  padding: 1rem;
  margin-bottom: 1rem;
  border-radius: 8px;
}

.project a {
  color: #58a6ff;
  text-decoration: none;
}

footer {
  text-align: center;
  padding: 1rem;
  background: #161b22;
  margin-top: 2rem;
}
